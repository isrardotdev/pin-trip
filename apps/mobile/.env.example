EXPO_PUBLIC_API_URL=https://api.wanderpin.app/api
EXPO_PUBLIC_MAPTILER_API_KEY=xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/dataviz-dark/style.json?key=YOUR_KEY
EXPO_PUBLIC_APP_SCHEME=wanderpin
# Web application OAuth client ID from Google Cloud Console (same one the backend
# verifies tokens against) — NOT the Android client ID, which is never referenced in code.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
