# Server
NODE_ENV=development
PORT=4000

# Database (NeonDB — managed PostgreSQL)
# From your Neon project dashboard → Connection Details
# Use the POOLED connection string for DATABASE_URL (goes through PgBouncer — used by the running app)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/wanderpin?sslmode=require
# Use the DIRECT (non-pooled) connection string for DIRECT_URL (bypasses pooler — used only by Prisma migrations)
DIRECT_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/wanderpin?sslmode=require

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=30d

# Groq (Free tier — transcription + LLM)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Google Gemini (Free tier — AI planner)
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxx

# Nominatim (OpenStreetMap geocoding — completely free, no key needed)
NOMINATIM_USER_AGENT=WanderPin/1.0 (dev@wanderpin.app)

# Maptiler (map tiles — free 100k/month)
MAPTILER_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your_expo_access_token

# yt-dlp path (installed globally or local binary)
YTDLP_PATH=/usr/local/bin/yt-dlp

# Temp file directory for audio processing
TEMP_DIR=/tmp/wanderpin

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
