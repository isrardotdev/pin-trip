generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String?
  name             String?
  avatarUrl        String?
  pushToken        String?
  plan             UserPlan         @default(FREE)
  planExpiresAt    DateTime?
  aiMessagesUsed   Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  pins             Pin[]
  conversations    Conversation[]
  savedItineraries SavedItinerary[]
  oauthAccounts    OAuthAccount[]
}

model OAuthAccount {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   // "apple" | "google"
  providerId String   // sub from Apple/Google token
  email      String?
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model Place {
  id           String        @id @default(cuid())
  name         String
  city         String?
  state        String?
  country      String        @default("India")
  lat          Float
  lng          Float
  thumbnailUrl String?
  aiConfidence Float?
  category     Category
  // OSM identity — used by mobile to fetch polygon boundary on demand
  osmType      String?       // "relation" | "way" | "node"
  osmId        BigInt?       // OSM entity ID (e.g. 1949380 for Spiti Valley)
  locationType String?       // "POINT" | "AREA"
  createdAt    DateTime      @default(now())
  pins         Pin[]
  sources      PlaceSource[]

  @@index([name, city, state])
}

// Maps a reel URL to a canonical Place (level-1 dedup key)
model PlaceSource {
  id      String @id @default(cuid())
  url     String @unique
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model Pin {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional link to canonical Place
  placeId            String?
  place              Place?     @relation(fields: [placeId], references: [id])

  name               String
  city               String?
  state              String?
  country            String     @default("India")
  lat                Float
  lng                Float
  googlePlaceId      String?

  source             SourceType @default(MANUAL)
  sourceUrl          String?
  sourceThumbnailUrl String?
  sourceCaption      String?

  status             PinStatus  @default(WISHLIST)
  category           Category   @default(NATURE)
  notes              String?
  visitedAt          DateTime?

  aiConfidence       Float?
  isManuallyVerified Boolean    @default(false)
  rawTranscript      String?

  // Denormalised from Place for fast client reads
  osmType            String?
  osmId              BigInt?
  locationType       String?    // "POINT" | "AREA"

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([lat, lng])
}

model UnresolvedPin {
  id                 String   @id @default(cuid())
  userId             String
  sourceUrl          String
  sourceThumbnailUrl String?
  sourceCaption      String?
  rawTranscript      String?
  aiResponse         String?
  createdAt          DateTime @default(now())
}

model DiscoverPlace {
  id          String   @id @default(cuid())
  name        String
  city        String
  state       String
  country     String   @default("India")
  lat         Float
  lng         Float
  description String?
  photoUrl    String?
  category    Category
  tags        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Conversation {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripDocument Json?
  destination  String?
  messages     Json[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SavedItinerary {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  destination String
  document    Json
  messages    Json[]
  createdAt   DateTime @default(now())

  @@index([userId])
}

enum UserPlan {
  FREE
  PRO
}

enum SourceType {
  INSTAGRAM
  YOUTUBE
  MANUAL
  DISCOVER
  PLANNER
}

enum PinStatus {
  WISHLIST
  PLANNING
  VISITED
}

enum Category {
  NATURE
  FOOD
  ADVENTURE
  CULTURE
  STAY
  OFFBEAT
}
